<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Weekly Lit Digest</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f5; font-family:Georgia, 'Times New Roman', serif; color:#1a1a1a;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden;">
          <tr>
            <td style="padding:28px 32px; background-color:#1f2937; color:#ffffff;">
              <div style="font-size:20px; font-weight:bold;">Weekly Lit Digest</div>
              <div style="font-size:13px; color:#c7ccd6; margin-top:4px;">{{ window_start }} &ndash; {{ window_end }} &middot; {{ count }} paper{{ "s" if count != 1 else "" }}</div>
            </td>
          </tr>
          {% if papers|length == 0 %}
          <tr>
            <td style="padding:32px;">
              <p style="font-size:15px; color:#4b5563;">No papers cleared the deep-read threshold this week.</p>
            </td>
          </tr>
          {% endif %}
          {% for paper in papers %}
          <tr>
            <td style="padding:24px 32px; border-bottom:1px solid #e5e7eb;">
              <div style="font-size:12px; font-weight:bold; color:#ffffff; background-color:{{ '#166534' if paper.triage_score >= 9 else '#1d4ed8' }}; display:inline-block; padding:2px 8px; border-radius:4px; margin-bottom:8px;">
                SCORE {{ paper.triage_score }}/10
              </div>
              <div style="font-size:17px; font-weight:bold; line-height:1.35;">
                <a href="{{ paper.link }}" style="color:#1a1a1a; text-decoration:none;">{{ paper.title }}</a>
              </div>
              <div style="font-size:13px; color:#6b7280; margin-top:4px;">{{ paper.authors }}</div>
              <div style="font-size:12px; color:#6b7280; margin-top:2px; text-transform:uppercase; letter-spacing:0.03em;">
                {{ paper.novel_or_incremental }}{% if paper.worth_followup %} &middot; worth follow-up{% endif %}
              </div>

              <p style="font-size:14.5px; line-height:1.55; margin:14px 0 0 0;">{{ paper.summary }}</p>

              {% if paper.key_contributions %}
              <div style="font-size:13px; font-weight:bold; margin-top:14px; color:#374151;">Key contributions</div>
              <ul style="font-size:14px; line-height:1.5; margin:6px 0 0 0; padding-left:20px;">
                {% for item in paper.key_contributions %}<li>{{ item }}</li>{% endfor %}
              </ul>
              {% endif %}

              {% if paper.limitations %}
              <div style="font-size:13px; font-weight:bold; margin-top:14px; color:#374151;">Limitations / critique</div>
              <ul style="font-size:14px; line-height:1.5; margin:6px 0 0 0; padding-left:20px;">
                {% for item in paper.limitations %}<li>{{ item }}</li>{% endfor %}
              </ul>
              {% endif %}

              <div style="font-size:13px; font-weight:bold; margin-top:14px; color:#374151;">Relevance to your interests</div>
              <p style="font-size:14px; line-height:1.5; margin:6px 0 0 0; color:#374151;">{{ paper.relevance_to_interests }}</p>
            </td>
          </tr>
          {% endfor %}
          <tr>
            <td style="padding:18px 32px; font-size:11px; color:#9ca3af;">
              Generated automatically by your literature tracker.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
