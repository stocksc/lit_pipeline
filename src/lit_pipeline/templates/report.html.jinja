<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{ report_title }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f5; font-family:Georgia, 'Times New Roman', serif; color:#1a1a1a;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5; padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden;">
          <tr>
            <td style="padding:28px 32px; background-color:#1f2937; color:#ffffff;">
              <div style="font-size:20px; font-weight:bold;">{{ report_title }}</div>
              <div style="font-size:13px; color:#c7ccd6; margin-top:4px;">{{ window_start }} &ndash; {{ window_end }} &middot; {{ count }} paper{{ "s" if count != 1 else "" }}</div>
            </td>
          </tr>
          {% if papers|length == 0 %}
          <tr>
            <td style="padding:32px;">
              <p style="font-size:15px; color:#4b5563;">No papers cleared the deep-read threshold in this window.</p>
            </td>
          </tr>
          {% endif %}
          {% for paper in papers %}
          <tr>
            <td style="padding:24px 32px; border-bottom:1px solid #e5e7eb;">
              <div style="font-size:12px; font-weight:bold; color:#ffffff; background-color:{{ '#166534' if paper.triage_score >= 9 else '#1d4ed8' }}; display:inline-block; padding:2px 8px; border-radius:4px; margin-bottom:8px;">
                SCORE {{ paper.triage_score }}/10
              </div>
              <div style="font-size:17px; font-weight:bold; line-height:1.35;">
                <a href="{{ paper.link }}" style="color:#1a1a1a; text-decoration:none;">{{ paper.title }}</a>
              </div>
              <div style="font-size:13px; color:#6b7280; margin-top:4px;">{{ paper.authors_display }}</div>

              <p style="font-size:14.5px; line-height:1.55; margin:14px 0 0 0;">{{ paper.summary }}</p>

              {% if paper.relevance %}
              <div style="font-size:13px; font-weight:bold; margin-top:14px; color:#374151;">Relevance</div>
              <ul style="font-size:14px; line-height:1.5; margin:6px 0 0 0; padding-left:20px;">
                {% for item in paper.relevance %}<li>{{ item }}</li>{% endfor %}
              </ul>
              {% endif %}

              {% if paper.limitations %}
              <div style="font-size:13px; font-weight:bold; margin-top:14px; color:#374151;">Limitations</div>
              <ul style="font-size:14px; line-height:1.5; margin:6px 0 0 0; padding-left:20px;">
                {% for item in paper.limitations %}<li>{{ item }}</li>{% endfor %}
              </ul>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
          {% if mid_tier_papers %}
          <tr>
            <td style="padding:16px 32px 4px 32px; background-color:#f9fafb;">
              <div style="font-size:13px; font-weight:bold; color:#374151; text-transform:uppercase; letter-spacing:0.03em;">
                Also relevant ({{ mid_tier_papers|length }})
              </div>
            </td>
          </tr>
          {% for paper in mid_tier_papers %}
          <tr>
            <td style="padding:12px 32px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb;">
              <div style="font-size:11px; font-weight:bold; color:#4b5563; background-color:#e5e7eb; display:inline-block; padding:1px 7px; border-radius:4px; margin-bottom:6px;">
                SCORE {{ paper.triage_score }}/10
              </div>
              <div style="font-size:15px; font-weight:bold; line-height:1.3;">
                <a href="{{ paper.link }}" style="color:#1a1a1a; text-decoration:none;">{{ paper.title }}</a>
              </div>
              <div style="font-size:12px; color:#9ca3af; margin-top:2px;">{{ paper.published_date }}</div>
              <p style="font-size:13.5px; line-height:1.5; margin:8px 0 0 0; color:#374151;">{{ paper.summary }}</p>
            </td>
          </tr>
          {% endfor %}
          {% endif %}
          <tr>
            <td style="padding:20px 32px; background-color:#f9fafb; border-bottom:1px solid #e5e7eb;">
              <div style="font-size:13px; font-weight:bold; color:#374151; text-transform:uppercase; letter-spacing:0.03em; margin-bottom:10px;">
                Other papers triaged this window ({{ triage_total }})
              </div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px; color:#4b5563;">
                <tr style="font-weight:bold; color:#374151;">
                  <td style="padding:2px 8px 4px 0;">Date</td>
                  <td style="padding:2px 8px 4px 0;">Paper</td>
                  <td style="padding:2px 0 4px 0; text-align:right;">Score</td>
                </tr>
                {% for row in triage_rows %}
                <tr>
                  <td style="padding:2px 8px 2px 0; white-space:nowrap;">{{ row.published_date }}</td>
                  <td style="padding:2px 8px 2px 0;">{{ row.title_short }}</td>
                  <td style="padding:2px 0; text-align:right; font-variant-numeric:tabular-nums;">{{ row.score }}</td>
                </tr>
                {% endfor %}
              </table>
              {% if triage_total > triage_rows|length %}
              <div style="font-size:12px; color:#9ca3af; margin-top:8px; font-style:italic;">
                + {{ triage_total - triage_rows|length }} more not shown
              </div>
              {% endif %}
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px; background-color:#f9fafb;">
              <div style="font-size:13px; font-weight:bold; color:#374151; text-transform:uppercase; letter-spacing:0.03em; margin-bottom:10px;">
                Cost this window (estimated)
              </div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px; color:#4b5563;">
                <tr>
                  <td style="padding:3px 0;">Triage ({{ costs.triage_count }} paper{{ "s" if costs.triage_count != 1 else "" }})</td>
                  <td style="padding:3px 0; text-align:right;">{{ "{:,}".format(costs.triage_input_tokens + costs.triage_output_tokens) }} tokens</td>
                  <td style="padding:3px 0 3px 16px; text-align:right; font-variant-numeric:tabular-nums;">${{ "%.4f"|format(costs.triage_cost_usd) }}</td>
                </tr>
                <tr>
                  <td style="padding:3px 0;">Mid-summary ({{ costs.mid_summary_count }} paper{{ "s" if costs.mid_summary_count != 1 else "" }})</td>
                  <td style="padding:3px 0; text-align:right;">{{ "{:,}".format(costs.mid_summary_input_tokens + costs.mid_summary_output_tokens) }} tokens</td>
                  <td style="padding:3px 0 3px 16px; text-align:right; font-variant-numeric:tabular-nums;">${{ "%.4f"|format(costs.mid_summary_cost_usd) }}</td>
                </tr>
                <tr>
                  <td style="padding:3px 0;">Deep read ({{ costs.deep_read_count }} paper{{ "s" if costs.deep_read_count != 1 else "" }})</td>
                  <td style="padding:3px 0; text-align:right;">{{ "{:,}".format(costs.deep_read_input_tokens + costs.deep_read_output_tokens) }} tokens</td>
                  <td style="padding:3px 0 3px 16px; text-align:right; font-variant-numeric:tabular-nums;">${{ "%.4f"|format(costs.deep_read_cost_usd) }}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0 0 0; font-weight:bold; border-top:1px solid #e5e7eb;">Total</td>
                  <td style="padding:6px 0 0 0; border-top:1px solid #e5e7eb;"></td>
                  <td style="padding:6px 0 0 16px; text-align:right; font-weight:bold; border-top:1px solid #e5e7eb; font-variant-numeric:tabular-nums;">${{ "%.4f"|format(costs.total_cost_usd) }}</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:18px 32px; font-size:11px; color:#9ca3af;">
              Generated automatically by your literature tracker.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
