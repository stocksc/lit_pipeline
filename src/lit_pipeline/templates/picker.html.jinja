<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report_title }}</title>
<script>
  // A width saved by dragging the divider is applied here, before first
  // paint, so it doesn't visibly jump into place once the page has drawn.
  // Same key as SIDEBAR_WIDTH_KEY in the script at the bottom.
  try {
    const savedWidth = Number(localStorage.getItem("lit-pick:sidebar-width"));
    if (savedWidth) document.documentElement.style.setProperty("--sidebar-width", savedWidth + "px");
  } catch (e) {
    // Storage unavailable: the default width applies.
  }
</script>
<style>
  :root {
    --sidebar-width: 340px;
    /* Papers pane */
    --bg: #f4f4f5;
    --surface: #ffffff;
    --border: #e5e7eb;
    --text: #1a1a1a;
    --text-2: #374151;
    --muted: #6b7280;
    --faint: #9ca3af;
    --link: #1d4ed8;
    --score-high: #166534;
    --score-mid: #1d4ed8;
    --score-low-bg: #e5e7eb;
    --score-low-text: #4b5563;
    --on-file-bg: #dcfce7;
    --on-file-text: #166534;
    --pill-bg: #eef2ff;
    --pill-text: #3730a3;
    --picked-border: #1d4ed8;
    --picked-bg: #f5f8ff;
    /* Sidebar: dark in both themes, the same slate as the email report's header */
    --side-bg: #1f2937;
    --side-text: #f3f4f6;
    --side-sub: #aab2bf;
    --side-border: #374151;
    --side-input-bg: #111827;
    --side-accent: #93c5fd;
    --side-primary: #2563eb;
    --side-primary-text: #ffffff;
    --bar: #4b5563;
    --bar-active: #60a5fa;
    --side-warn-bg: #422006;
    --side-warn-text: #fde68a;
    --side-warn-border: #78350f;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111318;
      --surface: #1a1d23;
      --border: #2e333b;
      --text: #e8e8ea;
      --text-2: #c9cdd4;
      --muted: #9aa1ac;
      --faint: #7b828d;
      --link: #7aa2ff;
      --score-high: #15803d;
      --score-mid: #2563eb;
      --score-low-bg: #2e333b;
      --score-low-text: #c9cdd4;
      --on-file-bg: #133a24;
      --on-file-text: #86efac;
      --pill-bg: #1e2540;
      --pill-text: #c7d2fe;
      --picked-border: #7aa2ff;
      --picked-bg: #1b2233;
      --side-bg: #0b0d10;
      --side-border: #23272e;
      --side-input-bg: #15181d;
    }
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { margin: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
  }
  .ui, button, input, select, summary, textarea {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  .layout {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    min-height: 100vh;
  }

  /* The draggable divider: a wide invisible grab area over the sidebar's
     right edge, showing a line on hover, focus, or while dragging. */
  .resizer {
    position: fixed;
    top: 0;
    bottom: 0;
    left: calc(var(--sidebar-width) - 4px);
    width: 9px;
    z-index: 6;
    cursor: col-resize;
    touch-action: none;
  }
  .resizer::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 3px;
    width: 3px;
    background: transparent;
    transition: background-color 0.15s;
  }
  .resizer:hover::after, .resizer:focus-visible::after, .is-resizing .resizer::after { background: var(--bar-active); }
  .resizer:focus-visible { outline: none; }
  .is-resizing, .is-resizing * { cursor: col-resize !important; user-select: none !important; }

  /* --- left pane */
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    background: var(--side-bg);
    color: var(--side-text);
    border-right: 1px solid var(--side-border);
  }
  .panel { padding: 18px 20px; }
  .panel + .panel { border-top: 1px solid var(--side-border); }
  .panel-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--side-sub);
    margin: 0 0 10px;
  }
  .brand h1 { font-size: 19px; line-height: 1.3; margin: 0; }
  .window { color: var(--side-sub); font-size: 13px; margin-top: 4px; }
  .warning {
    margin-top: 12px;
    padding: 9px 11px;
    border-radius: 6px;
    background: var(--side-warn-bg);
    color: var(--side-warn-text);
    border: 1px solid var(--side-warn-border);
    font-size: 12.5px;
    line-height: 1.45;
  }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(60px, 1fr)); gap: 6px; margin-top: 12px; }
  .stat { background: var(--side-input-bg); border: 1px solid var(--side-border); border-radius: 6px; padding: 6px 8px; }
  .stat-value { font-size: 15px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stat-label { font-size: 11px; color: var(--side-sub); margin-top: 1px; line-height: 1.25; }

  .histogram { display: grid; grid-template-columns: repeat(11, 1fr); gap: 4px; }
  .bar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 3px;
    background: none;
    border: 0;
    padding: 0;
    color: var(--side-sub);
    cursor: pointer;
    font-size: 10.5px;
  }
  .bar-track { height: 40px; display: flex; align-items: flex-end; }
  .bar-fill { width: 100%; background: var(--bar); border-radius: 3px 3px 0 0; }
  .bar.is-active .bar-fill { background: var(--bar-active); }
  .bar:hover .bar-fill, .bar:focus-visible .bar-fill { outline: 2px solid var(--side-text); outline-offset: 1px; }
  .bar-label { font-weight: 700; color: var(--side-text); font-size: 11px; }
  .hint { color: var(--side-sub); font-size: 12px; margin-top: 8px; }

  .field { display: block; margin-top: 10px; }
  .field:first-of-type { margin-top: 0; }
  .field-label { display: block; font-size: 12px; color: var(--side-sub); margin-bottom: 4px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .sidebar input[type="search"], .sidebar select {
    width: 100%;
    padding: 7px 9px;
    border: 1px solid var(--side-border);
    border-radius: 6px;
    background: var(--side-input-bg);
    color: var(--side-text);
    font-size: 14px;
  }
  .sidebar input[type="search"]::placeholder { color: var(--side-sub); }
  .toggles { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; font-size: 14px; }
  .toggles label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .toggles input { accent-color: var(--bar-active); }
  .list-actions { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
  .shown-count { font-size: 13px; color: var(--side-sub); margin-right: auto; white-space: nowrap; }

  .btn {
    border: 1px solid var(--side-border);
    background: var(--side-input-bg);
    color: var(--side-text);
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn:hover:not(:disabled) { border-color: var(--side-accent); }
  .btn-primary { background: var(--side-primary); border-color: var(--side-primary); color: var(--side-primary-text); font-weight: 600; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* The picks tray sits at the bottom of the sidebar, and stays pinned there
     when a short screen makes the sections above it scroll. */
  .picks {
    margin-top: auto;
    position: sticky;
    bottom: 0;
    background: var(--side-bg);
    box-shadow: 0 -8px 16px rgba(0, 0, 0, 0.25);
  }
  .picked-count { font-size: 16px; font-weight: 700; }
  .cost-note { font-size: 13px; color: var(--side-sub); margin-top: 3px; line-height: 1.4; }
  .pick-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
  .pick-buttons .btn-primary { grid-column: 1 / -1; padding: 9px 12px; font-size: 14px; }
  .status { font-size: 13px; color: var(--side-accent); min-height: 1.2em; margin-top: 8px; }
  .manual-copy {
    width: 100%;
    height: 80px;
    margin-top: 6px;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 12px;
    background: var(--side-input-bg);
    color: var(--side-text);
    border: 1px solid var(--side-border);
    border-radius: 6px;
    padding: 6px 8px;
    resize: vertical;
  }

  /* --- right pane */
  .papers-pane { padding: 24px 28px 48px; min-width: 0; }
  .papers-inner { max-width: 820px; }
  .empty { color: var(--muted); font-size: 15px; padding: 48px 0; text-align: center; }

  .paper {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 10px;
    overflow: hidden;
  }
  .paper.is-picked { border-color: var(--picked-border); background: var(--picked-bg); box-shadow: inset 3px 0 0 var(--picked-border); }
  .pick {
    display: flex;
    justify-content: center;
    padding-top: 20px;
    cursor: pointer;
    border-right: 1px solid var(--border);
  }
  .pick input { width: 18px; height: 18px; cursor: pointer; accent-color: var(--picked-border); }
  .paper-body { padding: 16px 18px 14px; min-width: 0; }
  .paper-tags { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 12px; }
  .score { font-weight: 700; color: #ffffff; padding: 2px 8px; border-radius: 4px; }
  .score-high { background: var(--score-high); }
  .score-mid { background: var(--score-mid); }
  .score-low { background: var(--score-low-bg); color: var(--score-low-text); }
  .orig { color: var(--faint); }
  .pill { background: var(--pill-bg); color: var(--pill-text); padding: 2px 8px; border-radius: 999px; }
  .on-file { background: var(--on-file-bg); color: var(--on-file-text); padding: 2px 8px; border-radius: 999px; font-weight: 600; }
  .paper-title { font-size: 17px; line-height: 1.35; margin: 8px 0 2px; overflow-wrap: anywhere; }
  .paper-title a { color: var(--text); text-decoration: none; }
  .paper-title a:hover { text-decoration: underline; }
  .byline { font-size: 13px; color: var(--muted); line-height: 1.5; overflow-wrap: anywhere; }
  .mono { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
  .more-authors { background: none; border: 0; padding: 0; color: var(--link); cursor: pointer; font-size: 12px; }
  .rationale { font-size: 14.5px; line-height: 1.5; margin: 10px 0 0; }
  .rationale .label {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-right: 6px;
  }
  details { margin-top: 8px; }
  summary { cursor: pointer; font-size: 13px; color: var(--link); user-select: none; }
  details p { font-size: 14px; line-height: 1.55; color: var(--text-2); margin: 6px 0 0; }

  /* --- narrow screens: stack the panes, pin the picks tray to the bottom */
  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .resizer { display: none; }
    .sidebar { position: static; height: auto; overflow: visible; border-right: 0; }
    .picks {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 5;
      padding: 12px 16px;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.3);
    }
    .pick-buttons { grid-template-columns: repeat(3, auto); justify-content: start; }
    .pick-buttons .btn-primary { grid-column: auto; padding: 7px 12px; font-size: 13px; }
    .panel { padding: 16px; }
    .papers-pane { padding: 16px 16px 190px; }
    .paper { grid-template-columns: 38px minmax(0, 1fr); }
    .paper-body { padding: 14px 14px 12px; }
  }
</style>
</head>
<body>
<div class="layout">
  <aside class="sidebar ui">
    <section class="panel brand">
      <h1>{{ report_title }}</h1>
      <div class="window">{{ window_start }} &ndash; {{ window_end }}</div>
      {% if unsearched_from %}
      <div class="warning" role="alert">
        arXiv stopped responding partway, so {{ unsearched_from }} &ndash; {{ window_end }} wasn't searched and
        papers from then may be missing. The terminal output has the command to finish it.
      </div>
      {% endif %}
      <div class="stat-grid">
        <div class="stat"><div class="stat-value">{{ papers|length }}</div><div class="stat-label">triaged</div></div>
        <div class="stat"><div class="stat-value">{{ deep_read_on_file }}</div><div class="stat-label">deep read on file</div></div>
        <div class="stat" title="What triaging this window has cost so far"><div class="stat-value">${{ "%.2f"|format(triage_cost_usd) }}</div><div class="stat-label">triage cost</div></div>
        {% if untriaged_count %}
        <div class="stat" title="In the window but without a triage score (left by a dry run, or triage failed), so not shown on this page."><div class="stat-value">{{ untriaged_count }}</div><div class="stat-label">unscored, hidden</div></div>
        {% endif %}
      </div>
    </section>

    {% if papers %}
    <section class="panel">
      <h2 class="panel-title">Scores</h2>
      <div class="histogram" role="group" aria-label="Papers by triage score">
        {% for score, count in histogram %}
        <button type="button" class="bar" data-score="{{ score }}" title="{{ count }} paper{{ '' if count == 1 else 's' }} scored {{ score }}. Click to show {{ score }} and above.">
          <span class="bar-count">{{ count }}</span>
          <span class="bar-track"><span class="bar-fill" style="height: {{ ((count / histogram_max * 100)|round(1)) if histogram_max else 0 }}%; min-height: {{ '2px' if count else '0' }};"></span></span>
          <span class="bar-label">{{ score }}</span>
        </button>
        {% endfor %}
      </div>
      <div class="hint">Click a score to show that score and above.</div>
    </section>
    {% endif %}

    <section class="panel">
      <h2 class="panel-title">Filter</h2>
      <label class="field">
        <span class="field-label">Search</span>
        <input type="search" id="search" placeholder="Titles, authors, abstracts, rationales">
      </label>
      <div class="field-row">
        <label>
          <span class="field-label">Minimum score</span>
          <select id="min-score">
            <option value="0">Any score</option>
            {% for score in range(1, 11) %}<option value="{{ score }}">{{ score }}+</option>{% endfor %}
          </select>
        </label>
        <label>
          <span class="field-label">Sort</span>
          <select id="sort">
            <option value="score">Highest score</option>
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
          </select>
        </label>
      </div>
      <div class="toggles">
        <label><input type="checkbox" id="hide-deep-read"> Hide deep-read</label>
        <label><input type="checkbox" id="picked-only"> Picked only</label>
      </div>
      <div class="list-actions">
        <span class="shown-count" id="shown-count"></span>
        <button type="button" class="btn" id="select-shown">Pick all shown</button>
        <button type="button" class="btn" id="clear-picks">Clear</button>
      </div>
    </section>

    <section class="panel picks">
      <div class="picked-count" id="picked-count">No papers picked</div>
      <div class="cost-note" id="cost-note">Tick papers to queue them for a deep dive.</div>
      <div class="pick-buttons">
        <button type="button" class="btn btn-primary" id="copy-ids" disabled>Copy IDs</button>
        <button type="button" class="btn" id="copy-command" disabled>Copy command</button>
        <button type="button" class="btn" id="download-ids" disabled>Download .txt</button>
      </div>
      <div class="status" id="status" role="status" aria-live="polite"></div>
      <textarea class="manual-copy" id="manual-copy" readonly hidden aria-label="Text to copy"></textarea>
    </section>
  </aside>
  <div class="resizer" id="resizer" role="separator" tabindex="0" aria-orientation="vertical" aria-label="Resize the sidebar (drag, or use the arrow keys; double-click to reset)" aria-valuemin="260" aria-valuemax="640" title="Drag to resize. Double-click to reset."></div>

  <main class="papers-pane">
    <div class="papers-inner">
      <noscript><p class="empty">Filtering, picking and copying need JavaScript turned on.</p></noscript>
      {% if not papers %}
      <p class="empty ui">No triaged papers in this window.</p>
      {% endif %}
      <p class="empty ui" id="no-matches" hidden>No papers match these filters.</p>
      <div id="papers">
        {% for paper in papers %}
        <article class="paper" data-id="{{ paper.arxiv_id }}" data-score="{{ paper.triage_score }}" data-date="{{ paper.published_date }}" data-deep-read="{{ '1' if paper.deep_read_summary else '0' }}">
          <label class="pick" title="Pick for a deep dive">
            <input type="checkbox" aria-label="Pick for a deep dive: {{ paper.title }}">
          </label>
          <div class="paper-body">
            <div class="paper-tags ui">
              <span class="score {{ 'score-high' if paper.triage_score >= 9 else ('score-mid' if paper.triage_score >= 7 else 'score-low') }}">{{ paper.triage_score }}/10</span>
              {% if paper.original_triage_score != paper.triage_score %}<span class="orig">originally {{ paper.original_triage_score }}/10</span>{% endif %}
              {% if paper.matched_interest %}<span class="pill">{{ paper.matched_interest }}</span>{% endif %}
              {% if paper.deep_read_summary %}<span class="on-file">Deep read on file</span>{% endif %}
            </div>
            <h2 class="paper-title"><a href="{{ paper.link }}" target="_blank" rel="noopener">{{ paper.title }}</a></h2>
            <div class="byline ui">
              {{ paper.published_date }} &middot; <span class="mono">{{ paper.arxiv_id }}</span>
              {% if paper.authors %}&middot; {{ paper.authors[:3]|join(", ") }}{% if paper.authors|length > 3 %}<span class="authors-rest" hidden>, {{ paper.authors[3:]|join(", ") }}</span> <button type="button" class="more-authors" data-more="+{{ paper.authors|length - 3 }} more">+{{ paper.authors|length - 3 }} more</button>{% endif %}{% endif %}
            </div>
            {% if paper.triage_rationale %}<p class="rationale"><span class="label">Triage</span>{{ paper.triage_rationale }}</p>{% endif %}
            {% if paper.abstract %}<details><summary>Abstract</summary><p>{{ paper.abstract }}</p></details>{% endif %}
            {% if paper.deep_read_summary %}<details><summary>Deep read summary</summary><p>{{ paper.deep_read_summary }}</p></details>
            {% elif paper.mid_summary %}<details><summary>Short summary</summary><p>{{ paper.mid_summary }}</p></details>{% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </main>
</div>

<script type="application/json" id="picker-config">{{ page_config|tojson }}</script>
<script>
(function () {
  "use strict";

  const config = JSON.parse(document.getElementById("picker-config").textContent);
  const list = document.getElementById("papers");
  const cards = Array.from(list.querySelectorAll(".paper"));
  // Server order: score descending, then newest first.
  const serverOrder = cards.slice();
  const byId = new Map(cards.map((card) => [card.dataset.id, card]));
  // Cached once: textContent includes collapsed <details> text, so search
  // covers abstracts and summaries without anyone having to expand them.
  const haystack = new Map(cards.map((card) => [card, card.textContent.toLowerCase().replace(/\s+/g, " ")]));

  const $ = (id) => document.getElementById(id);
  const search = $("search");
  const minScore = $("min-score");
  const sort = $("sort");
  const hideDeepRead = $("hide-deep-read");
  const pickedOnly = $("picked-only");
  const bars = Array.from(document.querySelectorAll(".bar"));

  // --- picks, persisted per window so a closed tab or a regenerated page
  // keeps them. Storage can be unavailable (private windows, blocked site
  // data), in which case picks just last as long as the tab.
  function loadPicks() {
    try {
      const stored = JSON.parse(localStorage.getItem(config.storageKey) || "[]");
      return new Set(Array.isArray(stored) ? stored : []);
    } catch (e) {
      return new Set();
    }
  }
  function savePicks() {
    try {
      localStorage.setItem(config.storageKey, JSON.stringify(Array.from(picks)));
    } catch (e) {
      // Nothing to do -- the page still works, picks just won't survive a reload.
    }
  }
  const picks = loadPicks();

  function syncCard(card) {
    const picked = picks.has(card.dataset.id);
    card.querySelector('input[type="checkbox"]').checked = picked;
    card.classList.toggle("is-picked", picked);
  }

  // Picks in the order they currently appear on the page.
  function pickedIds() {
    return Array.from(list.children)
      .filter((card) => picks.has(card.dataset.id))
      .map((card) => card.dataset.id);
  }

  // --- filtering and sorting
  function applyFilters() {
    const terms = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const min = Number(minScore.value) || 0;
    let shown = 0;
    for (const card of cards) {
      const visible =
        Number(card.dataset.score) >= min &&
        !(hideDeepRead.checked && card.dataset.deepRead === "1") &&
        !(pickedOnly.checked && !picks.has(card.dataset.id)) &&
        terms.every((term) => haystack.get(card).includes(term));
      card.hidden = !visible;
      if (visible) shown += 1;
    }
    $("shown-count").textContent = `Showing ${shown} of ${cards.length}`;
    $("no-matches").hidden = shown > 0 || cards.length === 0;
    for (const bar of bars) {
      bar.classList.toggle("is-active", Number(bar.dataset.score) >= min);
    }
  }

  function applySort() {
    const ordered = serverOrder.slice();
    const byScore = (a, b) => Number(b.dataset.score) - Number(a.dataset.score);
    if (sort.value === "newest") {
      ordered.sort((a, b) => b.dataset.date.localeCompare(a.dataset.date) || byScore(a, b));
    } else if (sort.value === "oldest") {
      ordered.sort((a, b) => a.dataset.date.localeCompare(b.dataset.date) || byScore(a, b));
    }
    const fragment = document.createDocumentFragment();
    ordered.forEach((card) => fragment.appendChild(card));
    list.appendChild(fragment);
  }

  // --- the picks tray
  function money(value) {
    return "$" + value.toFixed(2);
  }

  function updateTray() {
    const ids = pickedIds();
    const fresh = ids.filter((id) => byId.get(id).dataset.deepRead !== "1").length;
    const onFile = ids.length - fresh;
    $("picked-count").textContent =
      ids.length === 0 ? "No papers picked" : ids.length === 1 ? "1 paper picked" : `${ids.length} papers picked`;

    let note;
    if (ids.length === 0) {
      note = "Tick papers to queue them for a deep dive.";
    } else {
      const parts = [];
      if (fresh) {
        parts.push(
          config.avgDeepReadCost == null
            ? `${fresh} new deep read${fresh === 1 ? "" : "s"} (no deep-read history yet to estimate cost from)`
            : `~${money(fresh * config.avgDeepReadCost)} for ${fresh} new deep read${fresh === 1 ? "" : "s"}`
        );
      }
      if (onFile) parts.push(`${onFile} already on file (free)`);
      note = parts.join(" · ");
    }
    $("cost-note").textContent = note;

    for (const id of ["copy-ids", "copy-command", "download-ids"]) {
      $(id).disabled = ids.length === 0;
    }
  }

  let statusTimer = null;
  function flash(message) {
    $("status").textContent = message;
    clearTimeout(statusTimer);
    statusTimer = setTimeout(() => {
      $("status").textContent = "";
    }, 5000);
  }

  function legacyCopy(text) {
    const area = document.createElement("textarea");
    area.value = text;
    area.setAttribute("readonly", "");
    area.style.position = "fixed";
    area.style.top = "-1000px";
    document.body.appendChild(area);
    area.select();
    let copied = false;
    try {
      copied = document.execCommand("copy");
    } catch (e) {
      copied = false;
    }
    area.remove();
    return copied;
  }

  // Pages opened from disk (file://) don't always get the async clipboard,
  // so fall back to execCommand, and failing that, show the text selected
  // for a manual Ctrl+C.
  async function copyText(text, what) {
    const manual = $("manual-copy");
    try {
      if (!navigator.clipboard) throw new Error("no async clipboard");
      await navigator.clipboard.writeText(text);
    } catch (e) {
      if (!legacyCopy(text)) {
        manual.value = text;
        manual.hidden = false;
        manual.focus();
        manual.select();
        flash("The browser blocked the clipboard, so the text is selected below: press Ctrl+C to copy it.");
        return;
      }
    }
    manual.hidden = true;
    flash(`Copied ${what}.`);
  }

  // --- events
  list.addEventListener("change", (event) => {
    const box = event.target;
    if (!box.matches('input[type="checkbox"]')) return;
    const card = box.closest(".paper");
    if (box.checked) picks.add(card.dataset.id);
    else picks.delete(card.dataset.id);
    card.classList.toggle("is-picked", box.checked);
    savePicks();
    updateTray();
  });

  list.addEventListener("click", (event) => {
    const button = event.target.closest(".more-authors");
    if (!button) return;
    const rest = button.previousElementSibling;
    rest.hidden = !rest.hidden;
    button.textContent = rest.hidden ? button.dataset.more : "fewer";
  });

  search.addEventListener("input", applyFilters);
  minScore.addEventListener("change", applyFilters);
  hideDeepRead.addEventListener("change", applyFilters);
  pickedOnly.addEventListener("change", applyFilters);
  sort.addEventListener("change", () => {
    applySort();
    updateTray();
  });

  for (const bar of bars) {
    bar.addEventListener("click", () => {
      minScore.value = bar.dataset.score;
      applyFilters();
    });
  }

  $("select-shown").addEventListener("click", () => {
    let added = 0;
    for (const card of cards) {
      if (card.hidden || picks.has(card.dataset.id)) continue;
      picks.add(card.dataset.id);
      syncCard(card);
      added += 1;
    }
    savePicks();
    updateTray();
    flash(added ? `Picked ${added} more paper${added === 1 ? "" : "s"}.` : "Everything shown is already picked.");
  });

  $("clear-picks").addEventListener("click", () => {
    const count = pickedIds().length;
    if (count === 0) return;
    if (count > 3 && !window.confirm(`Clear all ${count} picks?`)) return;
    picks.clear();
    cards.forEach(syncCard);
    savePicks();
    updateTray();
    applyFilters();
  });

  // Space-separated rather than one per line: pasted after a command in a
  // terminal, each line would run as a command of its own, and a single-line
  // box would run the ids together. --ids-file splits on spaces too.
  $("copy-ids").addEventListener("click", () => {
    const ids = pickedIds();
    copyText(ids.join(" "), `${ids.length} ID${ids.length === 1 ? "" : "s"}`);
  });

  $("copy-command").addEventListener("click", () => {
    copyText("uv run lit-deep-dive " + pickedIds().join(" "), "the lit-deep-dive command");
  });

  $("download-ids").addEventListener("click", () => {
    const body =
      `# lit-pick: ${config.windowLabel}\n` +
      `# Run: uv run lit-deep-dive --ids-file ${config.idsFilename}\n` +
      pickedIds().join("\n") +
      "\n";
    const url = URL.createObjectURL(new Blob([body], { type: "text/plain" }));
    const link = document.createElement("a");
    link.href = url;
    link.download = config.idsFilename;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    flash(`Downloaded ${config.idsFilename}.`);
  });

  // --- resizable sidebar. The width is a per-browser preference shared by
  // every lit-pick page, not per window like the picks are.
  const SIDEBAR_WIDTH_KEY = "lit-pick:sidebar-width";
  const SIDEBAR_DEFAULT = 340;
  const SIDEBAR_MIN = 260;
  const SIDEBAR_MAX = 640;
  // Never squeeze the papers narrower than this.
  const PAPERS_MIN = 360;
  const KEY_STEP = 16;
  const root = document.documentElement;
  const resizer = $("resizer");

  function clampWidth(width) {
    const max = Math.max(SIDEBAR_MIN, Math.min(SIDEBAR_MAX, window.innerWidth - PAPERS_MIN));
    return Math.round(Math.min(max, Math.max(SIDEBAR_MIN, width)));
  }
  function currentWidth() {
    return parseFloat(getComputedStyle(root).getPropertyValue("--sidebar-width")) || SIDEBAR_DEFAULT;
  }
  function setWidth(width, persist) {
    const clamped = clampWidth(width);
    root.style.setProperty("--sidebar-width", clamped + "px");
    resizer.setAttribute("aria-valuenow", String(clamped));
    if (!persist) return;
    try {
      localStorage.setItem(SIDEBAR_WIDTH_KEY, String(clamped));
    } catch (e) {
      // The new width still applies; it just won't be remembered.
    }
  }

  // Drag tracking listens on the window rather than the divider, so a fast
  // drag that outruns the 9px grab area keeps going.
  let grabOffset = 0;
  function onDragMove(event) {
    setWidth(event.clientX - grabOffset, false);
  }
  function onDragEnd() {
    window.removeEventListener("pointermove", onDragMove);
    window.removeEventListener("pointerup", onDragEnd);
    window.removeEventListener("pointercancel", onDragEnd);
    document.body.classList.remove("is-resizing");
    setWidth(currentWidth(), true);
  }
  resizer.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    event.preventDefault();
    // Measured from where the divider was grabbed, so it doesn't jump to the cursor.
    grabOffset = event.clientX - currentWidth();
    document.body.classList.add("is-resizing");
    window.addEventListener("pointermove", onDragMove);
    window.addEventListener("pointerup", onDragEnd);
    window.addEventListener("pointercancel", onDragEnd);
  });
  resizer.addEventListener("dblclick", () => setWidth(SIDEBAR_DEFAULT, true));
  resizer.addEventListener("keydown", (event) => {
    const step = event.shiftKey ? KEY_STEP * 4 : KEY_STEP;
    if (event.key === "ArrowLeft") setWidth(currentWidth() - step, true);
    else if (event.key === "ArrowRight") setWidth(currentWidth() + step, true);
    else return;
    event.preventDefault();
  });
  // A narrower window can leave a saved width too wide for the papers;
  // clamp the shown width without overwriting the saved preference.
  window.addEventListener("resize", () => setWidth(currentWidth(), false));

  setWidth(currentWidth(), false);
  cards.forEach(syncCard);
  applyFilters();
  updateTray();
})();
</script>
</body>
</html>
