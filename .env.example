# Copy this file to .env for local development. Never commit the real .env.
# In GitHub Actions, these same names are set as repo Secrets instead
# (Settings -> Secrets and variables -> Actions) -- see README.md.

ANTHROPIC_API_KEY=

# Local dev convenience: path to your downloaded service-account JSON key file.
# (In GitHub Actions, GOOGLE_SERVICE_ACCOUNT_JSON holds the file's contents instead.)
GOOGLE_SERVICE_ACCOUNT_FILE=

RESEND_API_KEY=

# Where lit-weekly / lit-backfill send the digest email. Kept out of
# settings.yaml (which is committed) since it's a personal address.
REPORT_RECIPIENT_EMAIL=
